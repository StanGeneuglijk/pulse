# Same database and Redis as whoop-service.
# Local: this service's own docker-compose containers (5434 / 6381).
DATABASE_URL=postgresql+asyncpg://nutrition:nutrition@localhost:5434/nutrition_platform
# Hosted only: Supabase's direct connection, for Alembic. Leave empty locally.
DATABASE_URL_DIRECT=
REDIS_URL=redis://localhost:6381

# This service's own operator key. openssl rand -hex 32
API_KEY=
# console.anthropic.com -> API keys (chat)
ANTHROPIC_API_KEY=
# platform.openai.com -> API keys (voice transcription only). Optional:
# without it the service runs and only the audio route returns 503.
OPENAI_API_KEY=
# Optional; must be models listed in services/nutrition/pricing.py
# LLM_MODEL=claude-sonnet-5
# TRANSCRIPTION_MODEL=whisper-1
# Set by Render on every deploy; GET /version returns it. Leave unset locally.
# RENDER_GIT_COMMIT=

# Same database and Redis as whoop-service (this service reads its tables).
# Local: this service's own docker-compose containers (5433 / 6380).
DATABASE_URL=postgresql+asyncpg://insight:insight@localhost:5433/insight_platform
# Hosted only: Supabase's direct connection, for Alembic. Leave empty locally.
DATABASE_URL_DIRECT=
REDIS_URL=redis://localhost:6380

# This service's own operator key — not whoop-service's. openssl rand -hex 32
API_KEY=
# console.anthropic.com -> API keys. Also set a monthly spend limit there.
ANTHROPIC_API_KEY=
# Optional; must be a model listed in services/insight/pricing.py
# LLM_MODEL=claude-sonnet-5
# Set by Render on every deploy; GET /version returns it. Leave unset locally.
# RENDER_GIT_COMMIT=

# Local: the docker-compose Postgres. Hosted: Supabase's *pooled* connection
# string (port 6543), with the scheme changed to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://whoop:whoop@localhost:5432/whoop_platform
# Hosted only: Supabase's *direct* connection (port 5432) — used by Alembic
# migrations, never at runtime. Leave empty locally.
DATABASE_URL_DIRECT=
# Local: docker-compose Redis. Hosted: Upstash, rediss://default:<password>@<host>:6379
REDIS_URL=redis://localhost:6379

# From your WHOOP developer app (developer.whoop.com). The redirect URI must be
# registered on that app exactly as written here.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8000/auth/callback

# Encrypts WHOOP tokens at rest. Generate once and never change it — existing
# tokens become unreadable:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Operator key for /sync/batch and full access. openssl rand -hex 32
API_KEY=
# Concurrent WHOOP requests per sync job
WHOOP_FETCH_CONCURRENCY=3
# Where the OAuth callback sends the browser (the UI)
FRONTEND_URL=http://localhost:3000
# Set by Render on every deploy; GET /version returns it. Leave unset locally.
# RENDER_GIT_COMMIT=
